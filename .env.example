# Скопируйте в .env и заполните: cp .env.example .env

# --- Telegram ---
# Токен от @BotFather. Без него бот не запустится, но сайт и админка работают.
BOT_TOKEN=
# Имя бота без @ — для ссылок «Записаться в Telegram» на сайте.
BOT_USERNAME=
# Куда слать уведомления о новых записях: ваш chat id (узнать — у @userinfobot).
ADMIN_CHAT_ID=

# --- Админка (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- База данных ---
POSTGRES_PASSWORD=change-me-too

# --- Барбершоп ---
SHOP_NAME=Fade & Blade
SHOP_ADDRESS=Москва, ул. Покровка, 17
SHOP_PHONE=+7 (495) 000-00-00
SHOP_TZ=Europe/Moscow
# Публичный адрес сайта: используется в ссылке на политику в боте.
SITE_URL=http://localhost

# Бэкапы базы: каждые сутки в ./backups, хранятся столько дней.
BACKUP_KEEP_DAYS=14

# Демо-витрина для портфолио: подсказка логина в админке и сброс базы каждую ночь в 04:00.
# На настоящем барбершопе оставьте false!
DEMO_MODE=false

# Порт, на котором nginx отдаёт сайт.
WEB_PORT=80
